<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 表单模板 Form -->
    <record id="view_form_template_form" model="ir.ui.view">
        <field name="name">hc.form.template.form</field>
        <field name="model">hc.form.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_quick_setup" type="object"
                            string="一键配置审批"
                            class="btn-primary"
                            invisible="category_id"
                            groups="approval_cn.group_approval_admin"
                            help="点击自动创建审批类型、流程、节点"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_new_instance" type="object"
                                class="o_stat_button" icon="fa-plus-square"
                                string="新建表单" help="使用此模板发起一个新表单"/>
                        <button name="action_view_instances" type="object"
                                class="o_stat_button" icon="fa-list">
                            <field name="instance_count" widget="statinfo"
                                   string="实例"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="bool(id)"/>
                            <field name="code" readonly="bool(id)"
                                   groups="approval_cn.group_approval_admin"/>
                            <field name="category_id"
                                   options="{'no_create': True}"
                                   readonly="bool(id)"
                                   groups="approval_cn.group_approval_admin"
                                   help="关联到现有审批类型。如果没有，点击顶部一键配置审批按钮自动创建"/>
                        </group>
                        <group>
                            <field name="active"
                                   groups="approval_cn.group_approval_admin"/>
                        </group>
                    </group>
                    <group string="表单说明">
                        <field name="description" nolabel="1"
                               readonly="bool(id)"
                               groups="approval_cn.group_approval_admin"/>
                    </group>

                    <group string="字段配置" groups="approval_cn.group_approval_admin">
                        <field name="field_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="field_key"/>
                                <field name="field_type"/>
                                <field name="required"/>
                                <field name="width"/>
                                <field name="selection_options"
                                       invisible="field_type not in ('selection',)"/>
                                <field name="related_model"
                                       invisible="field_type not in ('many2one',)"/>
                                <field name="default_value"/>
                                <field name="placeholder"/>
                                <field name="help_text"/>
                                <field name="field_hint"
                                       string="填写说明"
                                       placeholder="例：请输入 A/B/C 中的一个值"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 表单模板 List -->
    <record id="view_form_template_list" model="ir.ui.view">
        <field name="name">hc.form.template.list</field>
        <field name="model">hc.form.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>
                <field name="instance_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- 表单模板 Kanban - 普通用户快速发起 -->
    <record id="view_form_template_kanban" model="ir.ui.view">
        <field name="name">hc.form.template.kanban</field>
        <field name="model">hc.form.template</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="category_id">
                <field name="name"/>
                <field name="code"/>
                <field name="instance_count"/>
                <field name="category_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="text-muted"><field name="code"/></div>
                                <span class="badge badge-pill mt-2">
                                    <field name="instance_count"/> 次使用
                                </span>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <span class="text-info small">
                                    <i class="fa fa-hand-pointer-o"/> 点击卡片进入
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- 表单模板 Search -->
    <record id="view_form_template_search" model="ir.ui.view">
        <field name="name">hc.form.template.search</field>
        <field name="model">hc.form.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="active" string="启用"
                        domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_form_template" model="ir.actions.act_window">
        <field name="name">表单模板</field>
        <field name="res_model">hc.form.template</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- 快速发起：只显示已启用的模板 -->
    <record id="action_form_template_quick" model="ir.actions.act_window">
        <field name="name">选择表单模板</field>
        <field name="res_model">hc.form.template</field>
        <field name="view_mode">kanban</field>
        <field name="domain">[('active', '=', True)]</field>
        <field name="view_id" ref="view_form_template_kanban"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                还没有表单模板
            </p>
            <p>
                请联系管理员配置表单模板。
            </p>
        </field>
    </record>

</odoo>
