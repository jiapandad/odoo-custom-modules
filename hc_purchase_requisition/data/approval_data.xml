<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================ -->
        <!--  审批类型：请购单审批                                          -->
        <!-- ============================================================ -->
        <record id="approval_category_purchase_requisition" model="approval.category">
            <field name="name">请购单审批</field>
            <field name="code">purchase_requisition</field>
            <field name="model_name">hc.purchase.requisition</field>
            <field name="active" eval="True"/>
        </record>

        <!-- ============================================================ -->
        <!--  默认审批流程：部门主管 → 用户组审批                            -->
        <!-- ============================================================ -->
        <record id="approval_flow_default" model="approval.flow">
            <field name="name">请购单标准审批流程</field>
            <field name="category_id" ref="approval_category_purchase_requisition"/>
            <field name="condition_type">always</field>
            <field name="is_default" eval="True"/>
            <field name="active" eval="True"/>
        </record>

        <!-- 节点1：部门主管或签 -->
        <record id="approval_node_dept_manager" model="approval.node">
            <field name="name">部门主管审批</field>
            <field name="flow_id" ref="approval_flow_default"/>
            <field name="sequence" eval="1"/>
            <field name="node_type">approver</field>
            <field name="sign_type">or_sign</field>
            <field name="approver_type">department_manager</field>
            <field name="timeout_hours" eval="24"/>
        </record>

    </data>
</odoo>
