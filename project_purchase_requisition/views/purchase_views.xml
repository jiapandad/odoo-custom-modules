<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_line_form_add_project" model="ir.ui.view">
        <field name="name">purchase.order.line.form.add.project</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" eval="1871"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='analytic_distribution']" position="before">
                <field name="project_id"
                       string="关联项目"
                       options="{'no_create': True, 'no_open': True}"
                       placeholder="选择关联的项目"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_line_add_project_col" model="ir.ui.view">
        <field name="name">purchase.order.line.list.add.project</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" eval="1870"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_qty']" position="after">
                <field name="project_id"
                       string="关联项目"
                       optional="show"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_form_add_project_col" model="ir.ui.view">
        <field name="name">purchase.order.form.add.project.col</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" eval="1861"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']" position="after">
                <field name="project_id"
                       string="关联项目"
                       optional="show"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
