<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 合同表单视图 -->
    <record id="view_purchase_contract_form" model="ir.ui.view">
        <field name="name">hc.purchase.contract.form</field>
        <field name="model">hc.purchase.contract</field>
        <field name="arch" type="xml">
            <form string="采购合同">
                <header>
                    <button name="action_submit_approval" type="object"
                            string="提交审批" class="btn-primary"
                            invisible="state not in ('draft', 'rejected')"/>
                    <button name="action_approve" type="object"
                            string="激活合同" class="btn-primary"
                            invisible="state != 'approved'"/>
                    <button name="action_close" type="object"
                            string="关闭合同" class="btn-secondary"
                            invisible="state not in ('active', 'approved')"/>
                    <button name="button_cancel" type="object"
                            string="撤回审批" class="btn-secondary"
                            invisible="state != 'submitted'"/>
                    <button name="button_draft" type="object"
                            string="退回草稿" class="btn-secondary"
                            invisible="state != 'rejected'"/>
                    <button name="action_create_po_from_framework" type="object"
                            string="创建采购订单" class="btn-primary"
                            invisible="not is_framework or state != 'active'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_contract_file" type="object"
                                class="o_stat_button" icon="fa-shopping-cart"
                                invisible="not rfq_id and not purchase_order_count">
                            <field name="purchase_order_count" widget="statinfo"
                                   string="采购订单"/>
                        </button>
                 <button name="action_view_contract_file" type="object"
                                class="o_stat_button" icon="fa-file-pdf-o"
                                invisible="not contract_file">
                            <div class="o_stat_info">
                                <field name="contract_file_name" class="o_stat_value"/>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="框架合同" bg_color="bg-success"
                            invisible="not is_framework"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="contract_type" widget="radio"
                                   required="1"/>
                            <field name="partner_id" required="1"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="contract_date"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="payment_terms" placeholder="如：月结30天、款到发货"/>
                            <field name="company_id"/>
                            <field name="department_id" readonly="1"/>
                            <field name="flow_id"
                                   invisible="state != 'draft'"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="合同明细">
                            <field name="line_ids">
                                <list editable="bottom" string="合同物料">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id" required="1"/>
                                    <field name="product_uom_id" required="1"/>
                                    <field name="quantity" required="1"/>
                                    <field name="price_unit" required="1"/>
                                    <field name="subtotal" widget="monetary"
                                           sum="总金额"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="合同文件">
                            <group>
                                <field name="contract_file" widget="binary"
                                       filename="contract_file_name"/>
                                <field name="contract_file_name" invisible="1"/>
                            </group>
                        </page>
                        <page string="备注">
                            <field name="description"/>
                        </page>
                        <page string="关联信息">
                            <group>
                                <field name="bid_comparison_id" readonly="1"/>
                                <field name="rfq_id" readonly="1"/>
                                <field name="approval_request_id" readonly="1"/>
                                <field name="approval_state" invisible="1"/>
                            </group>
                            <field name="purchase_order_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="date_order"/>
                                    <field name="amount_total" sum="关联PO总金额"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- 合同列表视图 -->
    <record id="view_purchase_contract_list" model="ir.ui.view">
        <field name="name">hc.purchase.contract.list</field>
        <field name="model">hc.purchase.contract</field>
        <field name="arch" type="xml">
            <list string="采购合同">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="contract_type"/>
                <field name="state"/>
                <field name="amount" widget="monetary" sum="合同总金额"/>
                <field name="payment_terms"/>
                <field name="department_id" optional="hide"/>
                <field name="company_id" optional="hide"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="contract_date"/>
                <field name="bid_comparison_id"/>
            </list>
        </field>
    </record>

    <!-- 合同搜索视图 -->
    <record id="view_purchase_contract_search" model="ir.ui.view">
        <field name="name">hc.purchase.contract.search</field>
        <field name="model">hc.purchase.contract</field>
        <field name="arch" type="xml">
            <search string="采购合同">
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="draft" string="草稿" domain="[('state', '=', 'draft')]"/>
                <filter name="submitted" string="待审批" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="已批准" domain="[('state', '=', 'approved')]"/>
                <filter name="active" string="执行中" domain="[('state', '=', 'active')]"/>
                <filter name="closed" string="已关闭" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="framework" string="框架合同"
                        domain="[('contract_type', '=', 'framework')]"/>
                <filter name="single" string="单次合同"
                        domain="[('contract_type', '=', 'single')]"/>
                <separator/>
                <filter name="my_contracts" string="我创建的"
                        domain="[('create_uid', '=', uid)]"/>
            </search>
        </field>
    </record>

    <!-- 合同菜单动作 -->
    <record id="action_purchase_contract" model="ir.actions.act_window">
        <field name="name">采购合同</field>
        <field name="res_model">hc.purchase.contract</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_purchase_contract_search"/>
        <field name="context">{'search_default_my_contracts': 1}</field>
    </record>

    <menuitem id="menu_purchase_contract"
              name="采购合同"
              action="action_purchase_contract"
              parent="purchase.menu_procurement_management"
              sequence="25"/>

</odoo>
