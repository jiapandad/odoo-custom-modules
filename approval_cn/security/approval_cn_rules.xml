<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- ── 审批请求记录规则 ── -->
    <record id="rule_approval_request_own" model="ir.rule">
        <field name="name">查看自己的审批请求</field>
        <field name="model_id" ref="model_approval_request"/>
        <field name="domain_force">
            ['|', ('request_user_id', '=', user.id),
                  ('record_ids.approver_id', '=', user.id)]
        </field>
        <field name="groups" eval="[(4, ref('group_approval_user'))]"/>
    </record>

    <record id="rule_approval_request_admin" model="ir.rule">
        <field name="name">管理员查看全部审批请求</field>
        <field name="model_id" ref="model_approval_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_approval_admin'))]"/>
    </record>

    <!-- ── 审批记录规则 ── -->
    <record id="rule_approval_record_own" model="ir.rule">
        <field name="name">查看自己的审批记录</field>
        <field name="model_id" ref="model_approval_record"/>
        <field name="domain_force">
            ['|', ('approver_id', '=', user.id),
                  ('request_id.request_user_id', '=', user.id)]
        </field>
        <field name="groups" eval="[(4, ref('group_approval_user'))]"/>
    </record>

    <!-- ── 抄送记录规则 ── -->
    <record id="rule_approval_cc_own" model="ir.rule">
        <field name="name">查看自己的抄送记录</field>
        <field name="model_id" ref="model_approval_cc"/>
        <field name="domain_force">
            ['|', ('user_id', '=', user.id),
                  ('request_id.request_user_id', '=', user.id)]
        </field>
        <field name="groups" eval="[(4, ref('group_approval_user'))]"/>
    </record>

    <record id="rule_approval_record_admin" model="ir.rule">
        <field name="name">管理员查看全部审批记录</field>
        <field name="model_id" ref="model_approval_record"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_approval_admin'))]"/>
    </record>

    <record id="rule_approval_cc_admin" model="ir.rule">
        <field name="name">管理员查看全部抄送记录</field>
        <field name="model_id" ref="model_approval_cc"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_approval_admin'))]"/>
    </record>
</odoo>