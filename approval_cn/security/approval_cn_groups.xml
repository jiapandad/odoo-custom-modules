<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="group_approval_user" model="res.groups">
        <field name="name">审批用户</field>
        <field name="comment">可以使用审批功能，提交和审批请求。</field>
    </record>

    <record id="group_approval_admin" model="res.groups">
        <field name="name">审批管理员</field>
        <field name="implied_ids" eval="[(4, ref('group_approval_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">可以管理审批类型、流程和节点配置。</field>
    </record>
</odoo>