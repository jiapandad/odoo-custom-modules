<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_approval_request_kanban" model="ir.ui.view">
        <field name="name">approval.request.kanban</field>
        <field name="model">approval.request</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state" quick_create="false">
                <field name="name"/>
                <field name="category_id"/>
                <field name="request_user_id"/>
                <field name="state"/>
                <field name="amount"/>
                <field name="record_count"/>
                <field name="cc_count"/>
                <t t-name="card">
                        <div class="o_kanban_card o_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><t t-esc="record.category_id.value"/></div>
                                <div class="text-muted">
                                    申请人：<t t-esc="record.request_user_id.value"/>
                                </div>
                                <div t-if="record.amount.value">
                                    金额：<strong><t t-esc="record.amount.value"/></strong>
                                </div>
                            </div>
                            <div class="o_kanban_bottom_left">
                                <span><field name="record_count"/>次处理</span>
                                <span t-if="record.cc_count.value" class="ms-2">
                                    | <field name="cc_count"/>抄送
                                </span>
                            </div>
                        </div>
                    </t>
            </kanban>
        </field>
    </record>

    <record id="view_approval_request_tree" model="ir.ui.view">
        <field name="name">approval.request.tree</field>
        <field name="model">approval.request</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'submitted'"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="category_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="amount" sum="审批金额合计"/>
                <field name="request_user_id"/>
                <field name="request_date"/>
                <field name="current_node_ids" widget="many2many_tags"/>
                <field name="record_count"/>
                <field name="cc_count"/>
            </list>
        </field>
    </record>

    <record id="action_attachment_approval_request" model="ir.actions.act_window">
        <field name="name">附件</field>
        <field name="res_model">ir.attachment</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('res_model', '=', 'approval.request'), ('res_id', '=', id)]</field>
    </record>

    <record id="action_approval_comment_wizard" model="ir.actions.act_window">
        <field name="name">审批意见</field>
        <field name="res_model">approval.comment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_approval_reject_wizard" model="ir.actions.act_window">
        <field name="name">驳回审批</field>
        <field name="res_model">approval.reject.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_approval_transfer_wizard" model="ir.actions.act_window">
        <field name="name">转交审批</field>
        <field name="res_model">approval.transfer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_approval_request_form" model="ir.ui.view">
        <field name="name">approval.request.form</field>
        <field name="model">approval.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object"
                            string="提交审批" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="%(action_approval_comment_wizard)d" type="action"
                            string="审批通过" class="btn-primary"
                            invisible="state != 'submitted'"
                            context="{'default_request_id': id}"/>
                    <button name="%(action_approval_reject_wizard)d" type="action"
                            string="驳回" class="btn-danger"
                            invisible="state != 'submitted'"
                            context="{'default_request_id': id}"/>
                    <button name="%(action_approval_transfer_wizard)d" type="action"
                            string="转交"
                            invisible="state != 'submitted'"
                            context="{'default_request_id': id}"/>
                    <button name="action_handler_done" type="object"
                            string="完成办理" class="btn-primary"
                            invisible="state != 'submitted'"/>
                    <button name="action_urge" type="object"
                            string="催办" class="btn-warning"
                            invisible="state != 'submitted'"/>
                    <button name="action_cancel" type="object"
                            string="撤回"
                            invisible="state not in ('draft', 'submitted')"/>
                    <button name="action_resubmit" type="object"
                            string="重新提交" class="btn-primary"
                            invisible="state != 'rejected'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,rejected,cancelled"/>
                </header>
                <sheet>
                    <div class="o_button_box" name="button_box">
                        <button name="action_view_records" type="object"
                                class="o_stat_button" icon="fa-history">
                            <field name="record_count" widget="statinfo"
                                   string="处理记录"/>
                        </button>
                        <button name="action_view_cc" type="object"
                                class="o_stat_button" icon="fa-envelope-o">
                            <field name="cc_count" widget="statinfo"
                                   string="抄送"/>
                        </button>
                        <button class="o_stat_button" icon="fa-paperclip"
                                type="action"
                                name="%(action_attachment_approval_request)d"
                                context="{'default_res_model': 'approval.request', 'default_res_id': id}">
                            <field name="attachment_count" widget="statinfo"
                                   string="附件"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category_id"/>
                            <field name="flow_id"/>
                            <field name="request_user_id"/>
                        </group>
                        <group>
                            <field name="model_name"/>
                            <field name="res_name"/>
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="request_date"/>
                        </group>
                    </group>

                    <group string="当前审批进度"
                           invisible="state == 'draft'">
                        <group colspan="2">
                            <field name="current_node_ids" widget="many2many_tags"
                                   nolabel="1"/>
                        </group>
                        <group>
                            <field name="approved_date"/>
                        </group>
                    </group>

                    <group string="申请说明">
                        <field name="description" nolabel="1"
                               placeholder="请描述申请原因..."/>
                    </group>

                    <group string="处理历史"
                           invisible="record_count == 0">
                        <field name="record_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="node_id"/>
                                <field name="record_type" widget="badge"/>
                                <field name="approver_id"/>
                                <field name="state" widget="badge"
                                       decoration-success="state == 'approved'"
                                       decoration-danger="state == 'rejected'"
                                       decoration-warning="state == 'pending'"
                                       decoration-muted="state == 'cancelled'"/>
                                <field name="comment"/>
                                <field name="approved_date"/>
                            </list>
                        </field>
                    </group>

                    <group string="抄送记录"
                           invisible="cc_count == 0">
                        <field name="cc_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="node_id"/>
                                <field name="user_id"/>
                                <field name="state" widget="badge"
                                       decoration-muted="state == 'unread'"
                                       decoration-success="state == 'read'"/>
                                <field name="read_date"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <div class="o_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_approval_request_search" model="ir.ui.view">
        <field name="name">approval.request.search</field>
        <field name="model">approval.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_id"/>
                <field name="request_user_id"/>
                <field name="model_name"/>
                <separator/>
                <filter name="draft_filter" string="草稿"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="submitted_filter" string="审批中"
                        domain="[('state', '=', 'submitted')]"/>
                <filter name="approved_filter" string="已通过"
                        domain="[('state', '=', 'approved')]"/>
                <filter name="rejected_filter" string="已驳回"
                        domain="[('state', '=', 'rejected')]"/>
                <filter name="cancelled_filter" string="已撤回"
                        domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="my_requests" string="我的申请"
                        domain="[('request_user_id', '=', uid)]"/>
                <separator/>
                <filter name="group_state" string="状态"
                        context="{'group_by': 'state'}"/>
                <filter name="group_category" string="审批类型"
                        context="{'group_by': 'category_id'}"/>
                <filter name="group_user" string="申请人"
                        context="{'group_by': 'request_user_id'}"/>
            </search>
        </field>
    </record>

    </odoo>