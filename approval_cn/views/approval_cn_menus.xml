<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_approval_category" model="ir.actions.act_window">
        <field name="name">审批类型</field>
        <field name="res_model">approval.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_approval_flow" model="ir.actions.act_window">
        <field name="name">审批流程</field>
        <field name="res_model">approval.flow</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_approval_node" model="ir.actions.act_window">
        <field name="name">审批节点</field>
        <field name="res_model">approval.node</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_approval_request" model="ir.actions.act_window">
        <field name="name">审批请求</field>
        <field name="res_model">approval.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_submitted_filter': 1}</field>
    </record>

    <record id="action_approval_record" model="ir.actions.act_window">
        <field name="name">审批记录</field>
        <field name="res_model">approval.record</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_approval_my_pending" model="ir.actions.act_window">
        <field name="name">我的待审批</field>
        <field name="res_model">approval.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('state', '=', 'submitted'), ('record_ids.approver_id', '=', uid), ('record_ids.state', '=', 'pending')]</field>
        <field name="context">{'search_default_submitted_filter': 1}</field>
    </record>

    <record id="action_approval_my_requests" model="ir.actions.act_window">
        <field name="name">我的申请</field>
        <field name="res_model">approval.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('request_user_id', '=', uid)]</field>
    </record>

    <menuitem id="menu_approval_cn_root"
              name="审批管理"
              action="action_approval_request"
              sequence="90"
              groups="base.group_system"/>

    <menuitem id="menu_approval_cn_config"
              name="配置"
              parent="menu_approval_cn_root"
              sequence="10"
              groups="base.group_system"/>

    <menuitem id="menu_approval_category"
              name="审批类型"
              parent="menu_approval_cn_config"
              action="action_approval_category"
              sequence="10"/>

    <menuitem id="menu_approval_flow"
              name="审批流程"
              parent="menu_approval_cn_config"
              action="action_approval_flow"
              sequence="20"/>

    <menuitem id="menu_approval_node"
              name="审批节点"
              parent="menu_approval_cn_config"
              action="action_approval_node"
              sequence="30"/>

    <menuitem id="menu_approval_my_pending"
              name="我的待审批"
              parent="menu_approval_cn_root"
              action="action_approval_my_pending"
              sequence="5"/>

    <menuitem id="menu_approval_my_requests"
              name="我的申请"
              parent="menu_approval_cn_root"
              action="action_approval_my_requests"
              sequence="10"/>

    <menuitem id="menu_approval_request"
              name="审批请求"
              parent="menu_approval_cn_root"
              action="action_approval_request"
              sequence="15"/>

    <menuitem id="menu_approval_record"
              name="审批记录"
              parent="menu_approval_cn_root"
              action="action_approval_record"
              sequence="20"/>
</odoo>